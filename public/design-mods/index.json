      },
      {
        "id": "wind-bell",
        "kind": "island",
        "entry": "surfaces/island.js",
        "style": "surfaces/island.css",
        "pointerMode": "interactive",
        "zOrder": "owned",
        "anchor": "main.right",
        "offset": {
          "x": 18,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 160
        },
        "requires": [
          "platform",
          "transparent-window",
          "native-satellite-v1",
          "interactive",
          "navigation-snapshot",
          "presenter-snapshot"
        ]
      }
    ]

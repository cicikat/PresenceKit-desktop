  {
    "schemaVersion": 2,
    "id": "koke-niwa",
    "name": "苔庭",
    "author": "PresenceKit",
    "version": "0.1.0",
    "entry": "entry.js",
    "style": "style.css",
    "theme": "theme/theme.json",
    "layout": "layout/layout.json",
    "nativeSurfaces": [
      {
        "id": "halo",
        "kind": "halo",
        "entry": "surfaces/halo.js",
        "style": "surfaces/halo.css",
        "pointerMode": "passthrough",

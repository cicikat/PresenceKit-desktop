{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PresenceKit-desktop",
  "version": "1.0.0",
  "identifier": "com.presencekit.desktop",
  "build": {
    "beforeDevCommand": "node scripts/tauri-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PresenceKit-desktop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/fonts/": "fonts/",
      "../public/themes/": "themes/",
      "../public/layouts/": "layouts/",
      "../public/design-mods/": "design-mods/",
      "../public/room/": "room/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

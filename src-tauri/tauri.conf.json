{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PresenceKit-desktop",
  "version": "1.3.0",
  "identifier": "com.presencekit.desktop",
  "build": {
    "beforeDevCommand": "node scripts/tauri-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PresenceKit-desktop",
        "decorations": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://localhost:1420 https://asset.localhost asset: http://asset.localhost; media-src 'self' http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/room/**", "**/room/**/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/fonts/": "fonts/",
      "../public/themes/": "themes/",
      "../public/layouts/": "layouts/",
      "../public/design-mods/": "design-mods/",
      "../public/room/": "room/",
      "../public/live2d/backgrounds/": "live2d/backgrounds/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

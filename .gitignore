# Python test cache
.pytest_cache/
__pycache__/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
config/client.local.json
.claude/

# 3D model assets (large binary files, not tracked in git).
# Directory itself stays tracked (via README.md placeholder) so `tauri build`'s
# resource bundling of ../public/room/ doesn't fail on a fresh checkout/CI.
public/room/character/*
!public/room/character/README.md
public/room/scene/*
!public/room/scene/README.md

# Live2D Cubism Core runtime (proprietary Live2D license, cannot be redistributed)
public/live2d/core/
# Live2D character model assets (large binary files, not tracked in git)
public/live2d/models/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
